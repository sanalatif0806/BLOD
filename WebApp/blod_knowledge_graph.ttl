<http://blod.isislab.it/resource/dataset/bioportal-ev> a blod:Dataset,
        void:Dataset,
        dcat:Dataset ;
    rdfs:label "eVOC (Expressed Sequence Annotation for Humans)"@en ;
    blod:aScore 0.5 ;
    blod:domain "life_sciences" ;
    blod:fScore 0.78 ;
    blod:fairScore 2.28 ;
    blod:hasFAIR <http://blod.isislab.it/resource/fair/bioportal-ev> ;
    blod:healthCategory <http://blod.isislab.it/resource/category/Terminologies___Metadata> ;
    blod:iScore 0.5 ;
    blod:identifier "bioportal-ev" ;
    blod:rScore 0.5 ;
    blod:triples 16187 ;
    dct:description "Provides structured controlled vocabularies for the annotation of expressed sequences with respect to anatomical system, cell type, developmental stage, experimental technique, microarray platform, pathology, pooling, tissue preparation and treatment."@en ;
    dct:identifier "bioportal-ev" ;
