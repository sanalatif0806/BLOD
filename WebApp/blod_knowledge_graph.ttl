<http://blod.isislab.it/resource/dataset/bioportal-snpo> a blod:Dataset,
        void:Dataset,
        dcat:Dataset ;
    rdfs:label "SNP-Ontology"@en ;
    blod:aScore 0.5 ;
    blod:domain "life_sciences" ;
    blod:fScore 0.78 ;
    blod:fairScore 2.28 ;
    blod:hasFAIR <http://blod.isislab.it/resource/fair/bioportal-snpo> ;
    blod:healthCategory <http://blod.isislab.it/resource/category/Terminologies___Metadata> ;
    blod:iScore 0.5 ;
    blod:identifier "bioportal-snpo" ;
    blod:rScore 0.5 ;
    blod:triples 42131 ;
    dct:description "SNP-Ontology is a domain ontology that provides a formal representation (OWL-DL) of genomic variations. Despite its name, SNP-Ontology, is not limited to the representation of SNPs but it encompasses genomic variations in a broader meaning. SNP-Ontology is general enough to enable the representation of variations observed in genome of various species. Latest versions of SNP-Ontology include the representation of haplotype and of CNV. The unambiguous representation of genomic variations provided by SNP-Ontology enables to integrate heterogeneous data related to genomic variations. To achieve this goal SNP-Ontology enables (1) to represent one variation in accordance with various ways that exist for describing it, (2) to represent the equivalence between two distinct descriptions of one variation, and (3) to represent correspondence between a genomic variation and its outcome at the transcriptome and proteome levels."@en ;
    dct:identifier "bioportal-snpo" ;
    dct:title "SNP-Ontology"@en ;
