    blod:triples 5819 ;
    dct:description "The goal of DDI project is to develop an ontology for the description of drug discovery investigations. DDI aims to follow to the OBO (Open Biomedical Ontologies) Foundry principles, uses relations laid down in the OBO Relation Ontology, and be compliant with Ontology for biomedical investigations (OBI)."@en ;
    dct:identifier "bioportal-ddi" ;
    dct:title "Ontology for Drug Discovery Investigations"@en ;
