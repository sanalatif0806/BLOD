<http://blod.isislab.it/resource/dataset/bioportal-efo> a blod:Dataset,
        void:Dataset,
        dcat:Dataset ;
    rdfs:label "Experimental Factor Ontology"@en ;
    blod:aScore 0.5 ;
    blod:domain "life_sciences" ;
    blod:fScore 0.76 ;
    blod:fairScore 2.26 ;
    blod:hasFAIR <http://blod.isislab.it/resource/fair/bioportal-efo> ;
    blod:healthCategory <http://blod.isislab.it/resource/category/Terminologies___Metadata> ;
    blod:iScore 0.5 ;
    blod:identifier "bioportal-efo" ;
    blod:rScore 0.5 ;
    blod:triples 81324 ;
    dct:description "The Experimental Factor Ontology (EFO) is an application focused ontology modelling the experimental variables in the Gene Expression Atlas, EBI. The ontology has been developed to increase the richness of the annotations that are currently made in the ArrayExpress repository, to promote consistent annotation, to facilitate automatic annotation and to integrate external data. The ontology describes cross-product classes from reference ontologies in area such as disease, cell line, cell type and anatomy. Contact James Malone for info: malone@ebi.ac.uk"@en ;
    dct:identifier "bioportal-efo" ;
    dct:title "Experimental Factor Ontology"@en ;
