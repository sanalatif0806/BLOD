            void:triples 26144 ],
        [ a void:Linkset ;
            void:target <http://blod.isislab.it/resource/dataset/PGxLOD>,
                <http://blod.isislab.it/resource/dataset/bio2rdf-pharmgkb> ;
            void:triples 69015 ] ;
