    blod:triples 8123 ;
    dct:description "The semanticscience integrated ontology (SIO) provides a simple, integrated upper level ontology (types, relations) for consistent knowledge representation across physical, processual and informational entities. It provides vocabulary for the Bio2RDF (http://bio2rdf.org) and SADI (http://sadiframework.org) projects."@en ;
    dct:identifier "bioportal-sio" ;
    dct:license <http://www.opendefinition.org/licenses/cc-by> ;
    dct:title "SemanticScience Integrated Ontology"@en ;
