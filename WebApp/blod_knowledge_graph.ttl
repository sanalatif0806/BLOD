<http://blod.isislab.it/resource/dataset/bioportal-mccl_x1> a blod:Dataset,
        void:Dataset,
        dcat:Dataset ;
    rdfs:label "Cell line ontology"@en ;
    blod:aScore 0.5 ;
    blod:fScore 0.76 ;
    blod:fairScore 2.26 ;
    blod:hasFAIR <http://blod.isislab.it/resource/fair/bioportal-mccl_x1> ;
    blod:healthCategory <http://blod.isislab.it/resource/category/Terminologies___Metadata> ;
    blod:iScore 0.5 ;
    blod:identifier "bioportal-mccl_x1" ;
    blod:rScore 0.5 ;
    dct:description "Cell lines are key experimental models to understand protein interactions and signaling pathways. With a large pool of such data coming from different cell lines of different origin -of normal and -pathological tissues, proper analysis requires segregating data pertaining to specific cell lines. The project envisaged brings together hierarchical trees of organs, mammalian cell lines and diseases in one platform. Certain specific terms from Cell Type (CL) ontology, Foundational Model of Anatomy (FMA) and DOID ontologies are mapped for searchability. Ontology is developed in both OBO and OWL."@en ;
    dct:identifier "bioportal-mccl_x1" ;
    dct:title "Cell line ontology"@en ;
    void:subset [ a void:Linkset ;
            void:target <http://blod.isislab.it/resource/dataset/bioportal-hp_x1>,
                <http://blod.isislab.it/resource/dataset/bioportal-mccl_x1> ;
            void:triples 777 ],
