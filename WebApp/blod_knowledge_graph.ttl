<http://blod.isislab.it/resource/dataset/bioportal-pdq> a blod:Dataset,
        void:Dataset,
        dcat:Dataset ;
    rdfs:label "Physician Data Query"@en ;
    blod:aScore 0.5 ;
    blod:domain "life_sciences" ;
    blod:fScore 0.78 ;
    blod:fairScore 2.28 ;
    blod:hasFAIR <http://blod.isislab.it/resource/fair/bioportal-pdq> ;
