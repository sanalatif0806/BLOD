    blod:iScore 0.5 ;
    blod:identifier "bioportal-pdq" ;
    blod:rScore 0.5 ;
    blod:triples 124212 ;
    dct:description "Physician Data Query (PDQ) Terminology is part of NCI's comprehensive cancer information database, which contains expert summaries on a wide range of cancer topics, a listing of some 30,000 cancer clinical trials from around the world, a directory of genetics services professionals, the NCI Dictionary of Cancer Terms, and the NCI Drug Dictionary."@en ;
    dct:identifier "bioportal-pdq" ;
    dct:title "Physician Data Query"@en ;
